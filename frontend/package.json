{
  "name": "dubbed-core-foundation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src e2e vite.config.ts eslint.config.mjs playwright.config.mjs --max-warnings=0",
    "test": "vitest run",
    "test:browser": "playwright test --config playwright.config.mjs",
    "fixtures:alternate": "node scripts/build-alternate-fixture.mjs",
    "verify:phase1": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
